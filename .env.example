# Copy to .env and adjust. Never commit real secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=leaseloop
POSTGRES_USER=leaseloop
POSTGRES_PASSWORD=leaseloop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
# Cache for rate-limit counters (defaults to REDIS_URL)
CACHE_URL=

# Rate limits (DRF format: N/sec|min|hour|day)
THROTTLE_LOGIN_IP_RATE=5/min
THROTTLE_LOGIN_USER_RATE=5/min
THROTTLE_REFRESH_IP_RATE=30/min
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min
# Proxies in front of Django that append X-Forwarded-For (0 = trust only the TCP peer)
NUM_PROXIES=0

# Inbound webhooks (dev values; scripts/post_webhooks.py uses them by default)
SENDGRID_INBOUND_TOKEN=dev-sendgrid-token
TWILIO_AUTH_TOKEN=dev-twilio-token
# Set when behind a proxy so Twilio signatures are checked against the public URL
WEBHOOK_PUBLIC_BASE_URL=
OUTBOUND_BACKEND=apps.integrations.outbound.LogBackend

# LLM assistant: "mock" (no key needed) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
ASSISTANT_MIN_RETRIEVAL_SCORE=0.20
