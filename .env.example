# Copy to .env and adjust. Never commit real secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
# Browser origins of the front end. Required when a proxy (Vite, nginx) rewrites Host:
# the auth endpoints and Django's CSRF check compare the request Origin against these.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# With DJANGO_DEBUG=false the app refuses to start unless DJANGO_SECRET_KEY is a random
# value of 50+ characters:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# HTTPS settings default to on when DEBUG is off. Behind a TLS-terminating proxy:
TRUST_X_FORWARDED_PROTO=false
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# Other origins allowed to call the API from a browser (comma-separated; empty = none)
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=leaseloop
POSTGRES_USER=leaseloop
POSTGRES_PASSWORD=leaseloop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
# Cache for rate-limit counters (defaults to REDIS_URL)
CACHE_URL=

# Rate limits (DRF format: N/sec|min|hour|day)
THROTTLE_LOGIN_IP_RATE=5/min
THROTTLE_LOGIN_USER_RATE=5/min
THROTTLE_REFRESH_IP_RATE=30/min
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min
# Proxies in front of Django that append X-Forwarded-For (0 = trust only the TCP peer)
NUM_PROXIES=0

# Inbound webhooks (dev values; scripts/post_webhooks.py uses them by default)
SENDGRID_INBOUND_TOKEN=dev-sendgrid-token
TWILIO_AUTH_TOKEN=dev-twilio-token
# Set when behind a proxy so Twilio signatures are checked against the public URL
WEBHOOK_PUBLIC_BASE_URL=
OUTBOUND_BACKEND=apps.integrations.outbound.LogBackend

# LLM assistant: "mock" (no key needed) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
ASSISTANT_MIN_RETRIEVAL_SCORE=0.20
