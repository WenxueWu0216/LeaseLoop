# Copy to .env and adjust. Never commit real secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=leaseloop
POSTGRES_USER=leaseloop
POSTGRES_PASSWORD=leaseloop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# LLM assistant: "mock" (no key needed) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
